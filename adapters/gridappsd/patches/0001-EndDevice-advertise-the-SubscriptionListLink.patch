From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ieee20305-interop <noreply@otfabric.invalid>
Date: Fri, 6 Nov 2026 12:00:00 +0100
Subject: [PATCH] EndDevice: advertise the SubscriptionListLink

sep2server v0.19.0 mounts GET and POST /edev/{id}/sub
(pkg/sep2srv/assembly/assembly.go:933-934), but no production path sets
EndDevice.SubscriptionListLink, so a client that follows links from /dcap,
as IEEE 2030.5 clients do, cannot find where to post a Subscription.

Stamp the link wherever the LogEventListLink is stamped (logEventLinks,
which the shared linkedEndDevices decorator calls on Create, Update, Get and
the href-derived read paths), with the href of the mounted route. Applied by
the ieee20305-interop gridappsd adapter (adapters/gridappsd/patches); nothing
else changes.
---
 pkg/store/memory/logeventbinding.go | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/pkg/store/memory/logeventbinding.go b/pkg/store/memory/logeventbinding.go
index a3f7fea..ed43bd2 100644
--- a/pkg/store/memory/logeventbinding.go
+++ b/pkg/store/memory/logeventbinding.go
@@ -52,6 +52,11 @@ import (
 // assertion in pkg/sep2srv/assembly rather than reaching a client.
 func LogEventListHref(key string) string { return "/edev/" + key + "/lel" }
 
+// SubscriptionListHref is the href of the subscription list of the device
+// stored under key: GET and POST /edev/{id}/sub are mounted, and the device
+// advertises them with its SubscriptionListLink (ieee20305-interop patch).
+func SubscriptionListHref(key string) string { return "/edev/" + key + "/sub" }
+
 // LogEventLinkedEndDeviceStore decorates any [store.EndDeviceStore] so every
 // EndDevice it serves advertises its LogEventList.
 //
@@ -75,6 +80,7 @@ type logEventLinks struct{}
 
 func (logEventLinks) derive(_ context.Context, d *sep2.EndDevice, key string) {
 	d.LogEventListLink = &sep2.ListLink{Href: LogEventListHref(key)}
+	d.SubscriptionListLink = &sep2.ListLink{Href: SubscriptionListHref(key)}
 }
 
 func (l logEventLinks) forWrite(ctx context.Context, d *sep2.EndDevice, key string) {
@@ -82,12 +88,13 @@ func (l logEventLinks) forWrite(ctx context.Context, d *sep2.EndDevice, key stri
 }
 
 func (logEventLinks) strip(d *sep2.EndDevice) bool {
-	had := d.LogEventListLink != nil
+	had := d.LogEventListLink != nil || d.SubscriptionListLink != nil
 	d.LogEventListLink = nil
+	d.SubscriptionListLink = nil
 	return had
 }
 
-func (logEventLinks) linkNames() string { return "LogEventListLink" }
+func (logEventLinks) linkNames() string { return "LogEventListLink and SubscriptionListLink" }
 
 // compile-time proof the decorator is substitutable for what it decorates,
 // and that it can be probed as part of a Delete chain (deleteProber).
-- 
